rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - subscription: string
    //   - subscriptionStatus: string
    //   - stripeCustomerId: string
    //
    // Collection: feed_posts
    // Fields:
    //   - authorId: string (required)
    //   - authorName: string (required)
    //   - content: string (required)
    //   - imageUrl: string (optional)
    //   - createdAt: timestamp (required)
    //   - likes: list (optional)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMasterAdmin() {
      return isAuthenticated() && request.auth.token.email in [
        "dvitalis1969@gmail.com", 
        "dnomsed@live.co.uk", 
        "aniakwlk@yahoo.co.uk",
        "pete@rfsuite.net",
        "info@rfsuite.net"
      ];
    }

    function isAdmin() {
      return isMasterAdmin() || (
        isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription == 'Enterprise'
      );
    }

    function isValidFeedPost(data) {
      return data.authorId is string && 
             data.authorName is string && data.authorName.size() < 100 &&
             data.content is string && data.content.size() < 5000;
    }

    function isRecent(time) {
      return time is timestamp && 
             time > request.time - duration.value(5, 'm') && 
             time < request.time + duration.value(5, 'm');
    }

    function isValidLiveShare(data) {
      return data.userId is string &&
             data.festivalName is string && data.festivalName.size() < 200 &&
             data.acts is string && data.acts.size() < 1000000 && // Up to 1MB string
             data.zones is string && data.zones.size() < 1000000 &&
             data.active is bool &&
             isRecent(data.updatedAt);
    }

    // Presence rules
    match /presence/{projectId}/users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Chat message rules
    match /messages/{chatId}/chat/{messageId} {
      allow read: if isAuthenticated() && (
        !chatId.matches('^dm_.*') || 
        chatId.matches('.*' + request.auth.uid + '.*')
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && (
        !chatId.matches('^dm_.*') || 
        chatId.matches('.*' + request.auth.uid + '.*')
      );
      allow update: if isAuthenticated() && (
        !chatId.matches('^dm_.*') || 
        chatId.matches('.*' + request.auth.uid + '.*')
      ) && (
        // Allow anyone in the chat to update reactions
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
        // Allow owner to edit text, editedAt, or linkPreview
        (resource.data.userId == request.auth.uid && 
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['text', 'editedAt', 'linkPreview']))
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid && (
        !chatId.matches('^dm_.*') || 
        chatId.matches('.*' + request.auth.uid + '.*')
      );
    }

    // Typing status rules
    match /messages/{chatId}/typing/{userId} {
      allow read: if isAuthenticated() && (
        !chatId.matches('^dm_.*') || 
        chatId.matches('.*' + request.auth.uid + '.*')
      );
      allow write: if isOwner(userId) && (
        !chatId.matches('^dm_.*') || 
        chatId.matches('.*' + request.auth.uid + '.*')
      );
    }

    // Project rules
    match /projects {
      allow list: if isAdmin();
      match /{projectId} {
        allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Plot rules
    match /plots/{plotId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User rules
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      
      // Unread DMs subcollection
      match /unread_dms {
        allow list: if isOwner(userId);
        
        match /{senderId} {
          allow read: if isOwner(userId);
          allow write: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == senderId);
        }
      }
    }

    // Public Profiles rules
    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }

    // Feed Posts rules
    match /feed_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                    request.resource.data.authorId == request.auth.uid && 
                    isValidFeedPost(request.resource.data);
      allow update: if isAuthenticated() && (
        // Allow owner to edit content
        (resource.data.authorId == request.auth.uid && 
         request.resource.data.authorId == resource.data.authorId &&
         isValidFeedPost(request.resource.data)) ||
        // Allow others to like/comment (only specific fields changing)
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'comments']) &&
         request.resource.data.authorId == resource.data.authorId)
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Contact Messages rules
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read: if true;
      allow update: if isAdmin();
    }

    // Announcements rules
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() && (
        resource.data.organizationId == null || 
        resource.data.organizationId == request.auth.uid ||
        resource.data.organizationId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId
      );
      allow write: if isAdmin();
    }

    // Live Shares rules
    match /live_shares/{shareId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    isValidLiveShare(request.resource.data);
      allow update: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid && 
                    request.resource.data.userId == resource.data.userId &&
                    isValidLiveShare(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isValidContactMessage(data) {
      // userId, subject, message, createdAt, status are required.
      // userEmail is optional.
      return data.keys().hasAll(['userId', 'subject', 'message', 'createdAt', 'status']) &&
             (data.keys().hasOnly(['userId', 'subject', 'message', 'createdAt', 'status']) || 
              data.keys().hasOnly(['userId', 'userEmail', 'subject', 'message', 'createdAt', 'status'])) &&
             data.userId is string &&
             (!('userEmail' in data) || data.userEmail is string || data.userEmail == null) &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() < 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() < 5000 &&
             data.status is string &&
             data.createdAt is timestamp;
    }
  }
}
